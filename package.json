{
  "name": "book-of-heaven-scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Offline helper scripts (PDF page index, YouTube map, etc.) used by the Book of Heaven frontend. Not shipped to the browser.",
  "type": "module",
  "scripts": {
    "build-pdf-pages": "node scripts/build-pdf-page-index.mjs",
    "build-youtube-map": "node scripts/build-youtube-map.mjs",
    "ingest:narrated": "node scripts/ingest-corpus.mjs --workspace narrated",
    "ingest:text": "node scripts/ingest-corpus.mjs --workspace text"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "pdfjs-dist": "^4.10.38"
  }
}
