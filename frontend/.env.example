# Leave empty for local + ngrok: the browser uses the page origin
# (http://localhost:5173 or the reserved ngrok domain). Vite proxies
# /auth /rest /functions /realtime /storage to local Kong at :54331.
# Set this only in production against a hosted Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
VITE_USE_PGVECTOR_RAG=true
